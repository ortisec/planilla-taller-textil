};

const contenido = ICONOS[name] ?? ICONOS.aviso;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={clase}
  aria-hidden="true"
  set:html={contenido}
  {...resto}
/>
