---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
---

<Layout titulo="Planilla" subtitulo="Cuánto se debe pagar a cada trabajador. La semana va de sábado a viernes.">
  <div slot="acciones">
    <a class="boton secundario" href="/trabajo">
      <Icon name="documento" size={16} /> Anotar prendas
    </a>
    <a class="boton secundario" href="/horas">
      <Icon name="reloj" size={16} /> Anotar horas
    </a>
  </div>

  <div class="rejilla kpi mb-2">
    <div class="kpi resaltado">
      <div class="kpi-etiqueta"><Icon name="dinero" size={15} /> Total por pagar</div>
      <div class="kpi-valor" id="kpi-total">—</div>
      <div class="kpi-pie">A todos los trabajadores</div>
    </div>
    <div class="kpi">
      <div class="kpi-etiqueta"><Icon name="personas" size={15} /> Personas por pagar</div>
      <div class="kpi-valor" id="kpi-personas">—</div>
      <div class="kpi-pie">Con trabajo pendiente</div>
    </div>
    <div class="kpi">
      <div class="kpi-etiqueta"><Icon name="check" size={15} /> Ya pagado</div>
      <div class="kpi-valor" id="kpi-pagado">—</div>
      <div class="kpi-pie" id="kpi-pagos">—</div>
    </div>
  </div>

  <div id="sin-pendientes" class="alerta exito hidden mb-2">
    <Icon name="check" size={18} />
    <div>
      <strong>¡Todo al día!</strong>
      <div>
        Nadie tiene pagos pendientes. Cuando anotes trabajo en
        <a href="/trabajo">Registro diario</a> o <a href="/horas">Trabajo por horas</a> aparecerá aquí.
      </div>
    </div>
  </div>

  <div id="lista">
    <div class="tarjeta"><div class="tarjeta-cuerpo sin-datos">Cargando planilla…</div></div>
  </div>

  <div class="tarjeta mt-4">
    <div class="tarjeta-cabecera">
      <div>
        <h2>Ya pagado</h2>
        <p>Pagos que ya entregaste. Puedes ver el comprobante o deshacer el pago.</p>
      </div>
    </div>
    <div class="tarjeta-cuerpo sin-padding">
      <div class="tabla-envoltura">
        <table class="tabla">
          <thead>
            <tr>
              <th>Fecha de pago</th>
              <th>Trabajador</th>
              <th>Semana o periodo pagado</th>
              <th class="num">Monto</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="cuerpo-pagos">
            <tr><td colspan="5" class="sin-datos">Cargando…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>

<script>
  import {
    listarTrabajadores,
    listarPagos,
    registrarPago,
    anularPago,
    lineasDePago,
    lineasDePagoHoras,
    pendientesDelTaller,
  } from '../../lib/api.js';
  import { soles, numero, fecha, diaCorto, hoyISO, inicioSemana, finSemana, diaDePago, horasTexto, sumarDias } from '../../lib/format.js';
  import { qs, esc, toast, avisoError, confirmar, cargando } from '../../lib/ui.js';
  import { abrirPlanilla, sumaImportes } from '../../lib/planilla-doc.js';

  const lista = qs('#lista');
  const sinPendientes = qs('#sin-pendientes');
  const cuerpoPagos = qs('#cuerpo-pagos');

  const estado = {
    trabajadores: [],
    prendas: [],
    horas: [],
    pagos: [],
    abiertos: new Set(),
  };

  const ICONO_PLANILLA =
    '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>';

  const ICONO_IMPRIMIR =
    '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>';

  const documentoDe = (trabajadorId) =>
    estado.trabajadores.find((t) => t.id === trabajadorId)?.documento ?? null;

  /** Abre el documento con el detalle del trabajo (prendas + horas). */
  function verPlanilla({ titulo, trabajador, documento, prendas, horas, etiquetaTotal, etiquetaArchivo, notas }) {
    abrirPlanilla({
      titulo,
      subtitulo: 'Detalle del trabajo realizado',
      trabajador,
      documento,
      prendas,
      horas,
      etiquetaTotal: etiquetaTotal ?? 'Total a pagar',
      notas: notas ?? null,
      etiquetaArchivo: etiquetaArchivo ?? 'planilla',
    });
  }

  // ------------------------------------------------------------ agrupación

  /** Agrupa el trabajo pendiente por trabajador (prendas + horas). */
  function porTrabajador() {
    const mapa = new Map();

    const asegurar = (id, nombre) => {
      if (!mapa.has(id)) mapa.set(id, { id, nombre, prendas: [], horas: [] });
      return mapa.get(id);
    };

    estado.prendas.forEach((r) => asegurar(r.trabajador_id, r.trabajador).prendas.push(r));
    estado.horas.forEach((h) => asegurar(h.trabajador_id, h.trabajador).horas.push(h));

    return [...mapa.values()]
      .map((grupo) => ({
        ...grupo,
        total: sumaImportes(grupo.prendas) + sumaImportes(grupo.horas),
        dias: new Set([...grupo.prendas.map((r) => r.fecha), ...grupo.horas.map((h) => h.fecha)]).size,
      }))
      .sort((a, b) => a.nombre.localeCompare(b.nombre));
  }

  /** Semanas pendientes de un trabajador, de la más antigua a la más nueva. */
  function semanasDe(grupo) {
    const semanas = new Map();

    const asegurar = (fechaTrabajo) => {
      const semana = inicioSemana(fechaTrabajo);
      if (!semanas.has(semana)) semanas.set(semana, { semana, prendas: [], horas: [] });
      return semanas.get(semana);
    };

    grupo.prendas.forEach((r) => asegurar(r.fecha).prendas.push(r));
    grupo.horas.forEach((h) => asegurar(h.fecha).horas.push(h));

    return [...semanas.values()]
      .map((s) => ({
        ...s,
        totalPrendas: sumaImportes(s.prendas),
        totalHoras: sumaImportes(s.horas),
        total: sumaImportes(s.prendas) + sumaImportes(s.horas),
      }))
      .sort((a, b) => a.semana.localeCompare(b.semana));
  }

  /** Totales por día dentro de una semana. */
  function diasDe(semana) {
    const dias = new Map();

    const asegurar = (fechaTrabajo) => {
      if (!dias.has(fechaTrabajo)) dias.set(fechaTrabajo, { fecha: fechaTrabajo, prendas: 0, horas: 0, minutos: 0 });
      return dias.get(fechaTrabajo);
    };

    semana.prendas.forEach((r) => {
      asegurar(r.fecha).prendas += Number(r.subtotal);
    });
    semana.horas.forEach((h) => {
      const dia = asegurar(h.fecha);
      dia.horas += Number(h.subtotal);
      dia.minutos += Number(h.minutos);
    });

    return [...dias.values()].sort((a, b) => a.fecha.localeCompare(b.fecha));
  }

  // -------------------------------------------------------------- plantillas

  function bloqueSemana(grupo, semana) {
    const dias = diasDe(semana);
    const etiqueta = `${esc(grupo.id)}|${esc(semana.semana)}`;

    return `
      <div class="bloque">
        <div class="bloque-cabecera">
          <span>
            Semana del sábado ${esc(fecha(semana.semana))} al viernes ${esc(fecha(finSemana(semana.semana)))}
            <div class="pista">Se paga el sábado ${esc(fecha(diaDePago(semana.semana)))}</div>
          </span>
          <span class="fila">
            <span class="negrita">${esc(soles(semana.total))}</span>
            <button type="button" class="boton secundario pequeno" data-ver-semana="${etiqueta}">
              ${ICONO_PLANILLA} Ver
            </button>
            <button type="button" class="boton pequeno" data-pagar-semana="${etiqueta}">
              Pagar esta semana
            </button>
          </span>
        </div>
        <div class="tabla-envoltura">
          <table class="tabla">
            <thead>
              <tr>
                <th>Día</th>
                <th class="num">Prendas</th>
                <th class="num">Horas</th>
                <th class="num">Total</th>
              </tr>
            </thead>
            <tbody>
              ${dias
                .map(
                  (dia) => `
                <tr>
                  <td>${esc(diaCorto(dia.fecha))}${dia.minutos ? ` <span class="texto-suave texto-pequeno">(${esc(horasTexto(dia.minutos))})</span>` : ''}</td>
                  <td class="num ${dia.prendas ? '' : 'texto-suave'}">${dia.prendas ? esc(soles(dia.prendas)) : '—'}</td>
                  <td class="num ${dia.horas ? '' : 'texto-suave'}">${dia.horas ? esc(soles(dia.horas)) : '—'}</td>
                  <td class="num negrita">${esc(soles(dia.prendas + dia.horas))}</td>
                </tr>`
                )
                .join('')}
            </tbody>
            <tfoot>
              <tr>
                <td>Total de la semana</td>
                <td class="num">${esc(soles(semana.totalPrendas))}</td>
                <td class="num">${esc(soles(semana.totalHoras))}</td>
                <td class="num">${esc(soles(semana.total))}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>`;
  }

  function tarjetaTrabajador(grupo) {
    const id = esc(grupo.id);
    const abierto = estado.abiertos.has(grupo.id);
    const semanas = semanasDe(grupo);

    return `
      <div class="tarjeta">
        <div class="tarjeta-cuerpo">
          <div class="encabezado-partida">
            <div>
              <h2 style="font-size:19px">${esc(grupo.nombre)}</h2>
              <p class="texto-suave texto-pequeno">
                ${esc(numero(grupo.dias))} día(s) trabajado(s) · ${esc(numero(semanas.length))} semana(s) por pagar
              </p>
            </div>
            <div class="fila">
              <div style="text-align:right">
                <div class="etiqueta-dato">Se le debe</div>
                <div class="negrita" style="font-size:23px;line-height:1.15">${esc(soles(grupo.total))}</div>
              </div>
              <button type="button" class="boton secundario" data-ver="${id}">
                ${abierto ? 'Ocultar semanas' : 'Ver semanas'}
              </button>
              <button type="button" class="boton secundario" data-planilla="${id}">
                ${ICONO_PLANILLA} Planilla
              </button>
              <button type="button" class="boton" data-pagar="${id}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>
                Pagar todo
              </button>
            </div>
          </div>

          <div class="${abierto ? 'pasos-lista mt-4' : 'hidden'}" data-detalle="${id}">
            ${semanas.map((semana) => bloqueSemana(grupo, semana)).join('')}
          </div>
        </div>
      </div>`;
  }

  // ------------------------------------------------------------------ pintar

  function pintar() {
    const grupos = porTrabajador();
    const totalPendiente = sumaImportes(estado.prendas) + sumaImportes(estado.horas);

    qs('#kpi-total').textContent = soles(totalPendiente);
    qs('#kpi-personas').textContent = numero(grupos.length);
    qs('#kpi-pagado').textContent = soles(estado.pagos.reduce((s, p) => s + Number(p.monto), 0));
    qs('#kpi-pagos').textContent = `${numero(estado.pagos.length)} pago(s) realizados`;

    if (grupos.length === 0) {
      lista.innerHTML = '';
      lista.classList.add('hidden');
      sinPendientes.classList.remove('hidden');
    } else {
      sinPendientes.classList.add('hidden');
      lista.classList.remove('hidden');
      lista.innerHTML = grupos.map(tarjetaTrabajador).join('');
      conectarTarjetas(grupos);
    }

    pintarPagos();
  }

  function conectarTarjetas(grupos) {
    const buscarGrupo = (id) => grupos.find((g) => g.id === id);
    const buscarSemana = (grupo, semana) => semanasDe(grupo).find((s) => s.semana === semana);

    lista.querySelectorAll('[data-ver]').forEach((boton) => {
      boton.addEventListener('click', () => {
        const id = boton.dataset.ver;
        if (estado.abiertos.has(id)) estado.abiertos.delete(id);
        else estado.abiertos.add(id);
        pintar();
      });
    });

    lista.querySelectorAll('[data-planilla]').forEach((boton) => {
      boton.addEventListener('click', () => {
        const grupo = buscarGrupo(boton.dataset.planilla);
        verPlanilla({
          titulo: `Planilla de ${grupo.nombre}`,
          trabajador: grupo.nombre,
          documento: documentoDe(grupo.id),
          prendas: grupo.prendas,
          horas: grupo.horas,
        });
      });
    });

    lista.querySelectorAll('[data-ver-semana]').forEach((boton) => {
      boton.addEventListener('click', () => {
        const [id, semana] = boton.dataset.verSemana.split('|');
        const grupo = buscarGrupo(id);
        const datos = buscarSemana(grupo, semana);
        verPlanilla({
          titulo: `Planilla de ${grupo.nombre}`,
          trabajador: grupo.nombre,
          documento: documentoDe(grupo.id),
          prendas: datos.prendas,
          horas: datos.horas,
        });
      });
    });

    lista.querySelectorAll('[data-pagar-semana]').forEach((boton) => {
      boton.addEventListener('click', () => {
        const [id, semana] = boton.dataset.pagarSemana.split('|');
        const grupo = buscarGrupo(id);
        const datos = buscarSemana(grupo, semana);

        ejecutarPago({
          grupo,
          desde: semana,
          hasta: sumarDias(semana, 6),
          total: datos.total,
          descripcion: `la semana del sábado ${fecha(semana)} al viernes ${fecha(sumarDias(semana, 6))}`,
          boton,
        });
      });
    });

    lista.querySelectorAll('[data-pagar]').forEach((boton) => {
      boton.addEventListener('click', () => {
        const grupo = buscarGrupo(boton.dataset.pagar);
        const semanas = semanasDe(grupo);
        ejecutarPago({
          grupo,
          desde: semanas[0].semana,
          hasta: sumarDias(semanas[semanas.length - 1].semana, 6),
          total: grupo.total,
          descripcion: `${numero(semanas.length)} semana(s) de trabajo`,
          boton,
        });
      });
    });
  }

  function pintarPagos() {
    cuerpoPagos.innerHTML = estado.pagos.length
      ? estado.pagos
          .map(
            (p) => `
        <tr>
          <td>${esc(fecha(p.fecha_pago))}</td>
          <td class="negrita">${esc(p.trabajadores?.nombre ?? '—')}</td>
          <td class="texto-suave">
            ${
              p.semana
                ? `Semana del sábado ${esc(fecha(p.semana))} al viernes ${esc(fecha(sumarDias(p.semana, 6)))}`
                : `Del ${esc(fecha(p.fecha_inicio))} al ${esc(fecha(p.fecha_fin))}`
            }
          </td>
          <td class="num negrita">${esc(soles(p.monto))}</td>
          <td class="acciones-fila">
            <button type="button" class="boton icono" data-comprobante="${esc(p.id)}" title="Ver o descargar el comprobante">
              ${ICONO_IMPRIMIR}
            </button>
            <button type="button" class="boton icono peligro" data-anular="${esc(p.id)}" title="Deshacer el pago">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </td>
        </tr>`
          )
          .join('')
      : '<tr><td colspan="5" class="sin-datos">Todavía no registras ningún pago.</td></tr>';

    cuerpoPagos.querySelectorAll('[data-comprobante]').forEach((boton) => {
      boton.addEventListener('click', async () => {
        const pago = estado.pagos.find((p) => p.id === boton.dataset.comprobante);
        if (!pago) return;

        try {
          cargando(boton, true, '…');
          const [prendas, horas] = await Promise.all([lineasDePago(pago.id), lineasDePagoHoras(pago.id)]);

          verPlanilla({
            titulo: `Comprobante de ${pago.trabajadores?.nombre ?? ''}`,
            trabajador: pago.trabajadores?.nombre ?? '',
            documento: pago.trabajadores?.documento ?? documentoDe(pago.trabajador_id),
            prendas,
            horas,
            etiquetaTotal: 'Monto pagado',
            etiquetaArchivo: 'comprobante',
            notas: pago.notas,
          });
        } catch (error) {
          avisoError(error);
        } finally {
          cargando(boton, false);
        }
      });
    });

    cuerpoPagos.querySelectorAll('[data-anular]').forEach((boton) => {
      boton.addEventListener('click', async () => {
        const ok = await confirmar({
          titulo: 'Deshacer el pago',
          mensaje: 'El pago se borrará y ese trabajo volverá a aparecer como pendiente.',
          textoAceptar: 'Deshacer pago',
          peligro: true,
        });
        if (!ok) return;
        try {
          await anularPago(boton.dataset.anular);
          toast('Pago deshecho.', 'exito');
          await cargar();
        } catch (error) {
          avisoError(error);
        }
      });
    });
  }

  // ------------------------------------------------------------------ pagar

  async function ejecutarPago({ grupo, desde, hasta, total, descripcion, boton }) {
    const ok = await confirmar({
      titulo: `Pagar a ${grupo.nombre}`,
      mensaje: `Se pagarán ${soles(total)} por ${descripcion}.\n\n¿Confirmas que ya le entregaste el dinero?`,
      textoAceptar: 'Sí, ya le pagué',
    });
    if (!ok) return;

    try {
      cargando(boton, true, 'Guardando…');
      await registrarPago({
        trabajadorId: grupo.id,
        desde,
        hasta,
        fechaPago: hoyISO(),
        notas: null,
      });
      toast(`Pago de ${soles(total)} registrado.`, 'exito', 6000);
      await cargar();
    } catch (error) {
      avisoError(error);
    } finally {
      cargando(boton, false);
    }
  }

  // ------------------------------------------------------------------ carga

  async function cargar() {
    const [{ prendas, horas }, pagos, trabajadores] = await Promise.all([
      pendientesDelTaller(),
      listarPagos({}),
      listarTrabajadores(),
    ]);

    estado.prendas = prendas;
    estado.horas = horas;
    estado.pagos = pagos;
    estado.trabajadores = trabajadores;
    pintar();
  }

  (async () => {
    await cargar();

    const param = new URLSearchParams(location.search).get('trabajador');
    if (param) {
      estado.abiertos.add(param);
      pintar();
      lista.querySelector('[data-detalle]')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  })().catch((error) => {
    avisoError(error);
    lista.innerHTML = `<div class="tarjeta"><div class="tarjeta-cuerpo sin-datos">${esc(error.message)}</div></div>`;
  });
</script>
