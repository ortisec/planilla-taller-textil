---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
---

<Layout titulo="Comprobante de pago" subtitulo="Resumen imprimible del pago liquidado.">
  <div slot="acciones">
    <a class="boton secundario" href="/pagos">
      <Icon name="volver" size={15} /> Volver a pagos
    </a>
    <button type="button" class="boton" id="imprimir">
      <Icon name="imprimir" size={15} /> Imprimir
    </button>
  </div>

  <div id="cargando" class="tarjeta"><div class="tarjeta-cuerpo sin-datos">Cargando comprobante…</div></div>

  <div id="contenido" class="oculto">
    <div class="tarjeta">
      <div class="tarjeta-cuerpo">
        <div class="fila separado">
          <div>
            <h2 style="font-size:20px">Comprobante de pago</h2>
            <p class="texto-suave" id="sub-titulo"></p>
          </div>
          <div class="texto-suave texto-pequeno" id="numero-pago"></div>
        </div>

        <div class="rejilla dos mt-3">
          <div class="dato-partida">
            <span class="etiqueta-dato">Trabajador</span>
            <span class="valor-dato" id="trabajador">—</span>
            <span class="texto-suave texto-pequeno" id="documento"></span>
          </div>
          <div class="dato-partida">
            <span class="etiqueta-dato">Periodo trabajado</span>
            <span class="valor-dato" id="periodo">—</span>
            <span class="texto-suave texto-pequeno" id="dias"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="tarjeta">
      <div class="tarjeta-cabecera">
        <div>
          <h2>Detalle del trabajo pagado</h2>
          <p>Trabajo realizado en el periodo indicado.</p>
        </div>
      </div>
      <div class="tarjeta-cuerpo sin-padding">
        <div class="tabla-envoltura">
          <table class="tabla">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Partida</th>
                <th>Paquete</th>
                <th>Talla</th>
                <th>Operación</th>
                <th class="num">Cant.</th>
                <th class="num">P. unit.</th>
                <th class="num">Importe</th>
              </tr>
            </thead>
            <tbody id="cuerpo">
              <tr><td colspan="8" class="sin-datos">Cargando…</td></tr>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="5">Total pagado</td>
                <td class="num" id="total-cantidad">0</td>
                <td></td>
                <td class="num" id="total-importe">S/ 0.00</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <div class="tarjeta">
      <div class="tarjeta-cuerpo">
        <div class="rejilla dos">
          <div>
            <span class="etiqueta-dato">Notas</span>
            <p id="notas" class="mt-1">—</p>
          </div>
          <div class="rejilla dos">
            <div style="text-align:center; padding-top:60px">
              <div style="border-top:1px solid var(--texto); width:200px; margin:0 auto"></div>
              <p class="texto-suave texto-pequeno mt-1">Firma del trabajador</p>
            </div>
            <div style="text-align:center; padding-top:60px">
              <div style="border-top:1px solid var(--texto); width:200px; margin:0 auto"></div>
              <p class="texto-suave texto-pequeno mt-1">Administración</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { obtenerPago, lineasDePago } from '../../lib/api.js';
  import { soles, precioUnitario, numero, fecha, fechaLarga } from '../../lib/format.js';
  import { qs, esc, avisoError } from '../../lib/ui.js';

  const id = new URLSearchParams(location.search).get('id');

  async function cargar() {
    const [pago, lineas] = await Promise.all([obtenerPago(id), lineasDePago(id)]);

    if (!pago) {
      qs('#cargando').innerHTML = '<div class="tarjeta-cuerpo sin-datos">No se encontró el pago solicitado.</div>';
      return;
    }

    const trabajador = pago.trabajadores?.nombre ?? '—';
    qs('#trabajador').textContent = trabajador;
    qs('#documento').textContent = pago.trabajadores?.documento ? `Documento: ${pago.trabajadores.documento}` : '';
    qs('#periodo').textContent = `${fecha(pago.fecha_inicio)} → ${fecha(pago.fecha_fin)}`;
    qs('#dias').textContent = `${numero(new Set(lineas.map((l) => l.fecha)).size)} día(s) trabajados · ${numero(lineas.length)} líneas`;
    qs('#numero-pago').textContent = `Pago N° ${String(pago.id).slice(0, 8).toUpperCase()} · Emitido el ${fechaLarga(pago.fecha_pago)}`;
    qs('#sub-titulo').textContent = `Se pagó a ${trabajador} por el trabajo del periodo indicado.`;
    qs('#notas').textContent = pago.notas || 'Sin observaciones.';

    qs('#cuerpo').innerHTML = lineas
      .map(
        (l) => `
        <tr>
          <td>${esc(fecha(l.fecha))}</td>
          <td>${esc(l.partida_codigo)}</td>
          <td>${esc(l.paquete_numero)}</td>
          <td>${esc(l.paquete_talla)}</td>
          <td>${esc(l.operacion)}</td>
          <td class="num">${esc(numero(l.cantidad))}</td>
          <td class="num texto-suave">${esc(precioUnitario(l.precio_unitario))}</td>
          <td class="num negrita">${esc(soles(l.subtotal))}</td>
        </tr>`
      )
      .join('');

    const totalPiezas = lineas.reduce((s, l) => s + Number(l.cantidad), 0);
    const total = lineas.reduce((s, l) => s + Number(l.subtotal), 0);
    qs('#total-cantidad').textContent = numero(totalPiezas);
    qs('#total-importe').textContent = soles(total);

    qs('#cargando').classList.add('oculto');
    qs('#contenido').classList.remove('oculto');
  }

  qs('#imprimir').addEventListener('click', () => window.print());

  if (!id) {
    qs('#cargando').innerHTML = '<div class="tarjeta-cuerpo sin-datos">Falta el identificador del pago.</div>';
  } else {
    cargar().catch((error) => {
      avisoError(error);
      qs('#cargando').innerHTML = `<div class="tarjeta-cuerpo sin-datos">${esc(error.message)}</div>`;
    });
  }
</script>
