---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout titulo="Trabajo por horas" subtitulo="Anota los turnos trabajados; el sistema calcula las horas y lo que se paga.">
  <div slot="acciones">
    <a class="boton secundario" href="/trabajo">
      <Icon name="documento" size={16} /> Registrar por prendas
    </a>
  </div>

  <div class="tarjeta">
    <div class="tarjeta-cabecera">
      <div>
        <h2>Anotar un turno</h2>
        <p>Elige a la persona, el día y desde qué hora hasta qué hora trabajó.</p>
      </div>
    </div>
    <div class="tarjeta-cuerpo">
      <div class="formulario-rejilla">
        <div class="campo">
          <label for="trabajador">¿Quién trabajó?</label>
          <select id="trabajador"><option value="">Cargando…</option></select>
        </div>
        <div class="campo">
          <label for="fecha">¿Qué día?</label>
          <input type="date" id="fecha" />
        </div>
        <div class="campo">
          <label for="inicio">Desde</label>
          <input type="time" id="inicio" value="08:00" />
        </div>
        <div class="campo">
          <label for="fin">Hasta</label>
          <input type="time" id="fin" value="12:00" />
        </div>
        <div class="campo">
          <label for="tarifa">Pago por hora (S/)</label>
          <input type="number" id="tarifa" min="0" step="0.5" value="7" />
        </div>
      </div>

      <div class="fila mt-3">
        <button type="button" class="boton secundario pequeno" data-preset="08:00|12:00">Mañana 8:00 – 12:00</button>
        <button type="button" class="boton secundario pequeno" data-preset="14:00|19:00">Tarde 2:00 – 7:00</button>
      </div>

      <p class="pista mt-3" id="semana"></p>

      <div class="resumen-pago">
        <div>
          <div class="resumen-etiqueta" id="resumen-titulo">Se le pagará</div>
          <div class="resumen-monto" id="total-turno">S/ 0.00</div>
          <div class="pista" id="pista-turno">Elige a la persona y las horas.</div>
        </div>
        <button type="button" class="boton grande" id="guardar">
          <Icon name="check" size={17} /> Guardar turno
        </button>
      </div>

      <details class="mt-3">
        <summary class="pista" style="cursor:pointer">Agregar una nota (opcional)</summary>
        <input type="text" id="notas" class="mt-2" placeholder="Ej. apoyó en planchado, cubrió a otra compañera…" />
      </details>
    </div>
  </div>

  <div class="tarjeta">
    <div class="tarjeta-cabecera">
      <div>
        <h2>Lo anotado <span class="texto-suave" id="titulo-dia"></span></h2>
        <p>Turnos anotados en ese día. Si te equivocaste, borra la línea.</p>
      </div>
    </div>
    <div class="tarjeta-cuerpo sin-padding">
      <div class="tabla-envoltura">
        <table class="tabla">
          <thead>
            <tr>
              <th>Trabajador y horario</th>
              <th class="num" style="width:110px">Horas</th>
              <th class="num" style="width:130px">Pago por hora</th>
              <th class="num" style="width:130px">Se le paga</th>
              <th style="width:64px"></th>
            </tr>
          </thead>
          <tbody id="cuerpo-dia">
            <tr><td colspan="5" class="sin-datos">Cargando…</td></tr>
          </tbody>
          <tfoot id="pie-dia" class="hidden">
            <tr>
              <td colspan="3">Total del día</td>
              <td class="num" id="total-dia">S/ 0.00</td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { listarTrabajadores, registrarHoras, listarHoras, eliminarHoras } from '../lib/api.js';
  import { soles, numero, hoyISO, fecha, hora12, horasTexto, minutosDeHora, inicioSemana, finSemana, diaDePago } from '../lib/format.js';
  import { qs, esc, toast, avisoError, confirmar, cargando } from '../lib/ui.js';

  const elTrabajador = qs('#trabajador');
  const elFecha = qs('#fecha');
  const elInicio = qs('#inicio');
  const elFin = qs('#fin');
  const elTarifa = qs('#tarifa');
  const elNotas = qs('#notas');
  const elSemana = qs('#semana');
  const resumenTitulo = qs('#resumen-titulo');
  const totalTurno = qs('#total-turno');
  const pistaTurno = qs('#pista-turno');
  const cuerpoDia = qs('#cuerpo-dia');
  const pieDia = qs('#pie-dia');
  const totalDia = qs('#total-dia');
  const tituloDia = qs('#titulo-dia');
  const botonGuardar = qs('#guardar');

  const trabajadores = [];

  const minutosDelTurno = () => {
    const inicio = minutosDeHora(elInicio.value);
    const fin = minutosDeHora(elFin.value);
    return fin > inicio ? fin - inicio : 0;
  };

  function recalcular() {
    const minutos = minutosDelTurno();
    const tarifa = Number(elTarifa.value) || 0;
    const importe = (minutos / 60) * tarifa;

    totalTurno.textContent = soles(importe);

    const persona = trabajadores.find((t) => t.id === elTrabajador.value);
    resumenTitulo.textContent = persona ? `Se le pagará a ${persona.nombre}` : 'Se le pagará';
    pistaTurno.textContent =
      minutos > 0
        ? `${horasTexto(minutos)} × ${soles(tarifa)} por hora`
        : 'La hora de fin debe ser mayor que la de inicio.';
  }

  function pintarSemana() {
    const dia = elFecha.value || hoyISO();
    elSemana.textContent = `Este día pertenece a la semana del sábado ${fecha(inicioSemana(dia))} al viernes ${fecha(
      finSemana(dia)
    )} (se paga el sábado ${fecha(diaDePago(dia))}).`;
  }

  // ------------------------------------------------------------- catálogo

  async function cargarTrabajadores() {
    const lista = await listarTrabajadores({ soloActivos: true });
    trabajadores.length = 0;
    trabajadores.push(...lista);

    elTrabajador.innerHTML =
      '<option value="">Elige a la persona</option>' +
      lista.map((t) => `<option value="${esc(t.id)}">${esc(t.nombre)}</option>`).join('');
  }

  function aplicarTarifaDelTrabajador() {
    const persona = trabajadores.find((t) => t.id === elTrabajador.value);
    if (persona?.tarifa_hora) elTarifa.value = Number(persona.tarifa_hora);
    recalcular();
  }

  // --------------------------------------------------------------- guardar

  async function guardar() {
    if (!elTrabajador.value) return toast('Elige a la persona que trabajó.', 'aviso');
    if (!elFecha.value) return toast('Elige el día.', 'aviso');

    const minutos = minutosDelTurno();
    if (minutos <= 0) return toast('La hora de fin debe ser mayor que la hora de inicio.', 'aviso');

    const tarifa = Number(elTarifa.value) || 0;

    try {
      const repetidos = await listarHoras({
        desde: elFecha.value,
        hasta: elFecha.value,
        trabajadorId: elTrabajador.value,
        limite: 50,
      });

      const igual = repetidos.find(
        (h) => String(h.hora_inicio).slice(0, 5) === elInicio.value && String(h.hora_fin).slice(0, 5) === elFin.value
      );

      if (igual) {
        const continuar = await confirmar({
          titulo: 'Ese turno ya está anotado',
          mensaje: `Ya existe un turno de ${hora12(igual.hora_inicio)} a ${hora12(igual.hora_fin)} para ese día.\n\n¿Quieres anotarlo otra vez?`,
          textoAceptar: 'Sí, anotar igual',
        });
        if (!continuar) return;
      }

      cargando(botonGuardar, true, 'Guardando…');
      await registrarHoras({
        fecha: elFecha.value,
        trabajadorId: elTrabajador.value,
        horaInicio: elInicio.value,
        horaFin: elFin.value,
        tarifa,
        notas: elNotas.value || null,
      });

      toast('Turno guardado.', 'exito');
      elNotas.value = '';
      await cargarDia();
    } catch (error) {
      avisoError(error);
    } finally {
      cargando(botonGuardar, false);
    }
  }

  // ------------------------------------------------------------- del día

  async function cargarDia() {
    const dia = elFecha.value || hoyISO();
    tituloDia.textContent = `· ${fecha(dia)}`;
    cuerpoDia.innerHTML = '<tr><td colspan="5" class="sin-datos">Cargando…</td></tr>';

    const turnos = await listarHoras({ desde: dia, hasta: dia, limite: 200 });

    if (turnos.length === 0) {
      cuerpoDia.innerHTML = '<tr><td colspan="5" class="sin-datos">Todavía no anotaste turnos de este día.</td></tr>';
      pieDia.classList.add('hidden');
      return;
    }

    cuerpoDia.innerHTML = turnos
      .map(
        (h) => `
        <tr>
          <td>
            <div class="negrita">
              ${esc(h.trabajador)}
              ${h.pago_id ? '<span class="chip exito">Ya pagado</span>' : ''}
            </div>
            <div class="texto-suave texto-pequeno">
              ${esc(hora12(h.hora_inicio))} – ${esc(hora12(h.hora_fin))}${h.notas ? ' · ' + esc(h.notas) : ''}
            </div>
          </td>
          <td class="num">${esc(horasTexto(h.minutos))}</td>
          <td class="num texto-suave">${esc(soles(h.tarifa))}</td>
          <td class="num negrita">${esc(soles(h.subtotal))}</td>
          <td class="acciones-fila">
            <button type="button" class="boton icono peligro" data-borrar="${esc(h.id)}" title="Borrar">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </td>
        </tr>`
      )
      .join('');

    totalDia.textContent = soles(turnos.reduce((suma, h) => suma + Number(h.subtotal), 0));
    pieDia.classList.remove('hidden');

    cuerpoDia.querySelectorAll('[data-borrar]').forEach((boton) => {
      boton.addEventListener('click', async () => {
        const ok = await confirmar({
          titulo: 'Borrar este turno',
          mensaje: '¿Seguro que quieres borrarlo? Después puedes volver a anotarlo.',
          textoAceptar: 'Borrar',
          peligro: true,
        });
        if (!ok) return;
        try {
          await eliminarHoras(boton.dataset.borrar);
          toast('Turno borrado.', 'exito');
          await cargarDia();
        } catch (error) {
          avisoError(error);
        }
      });
    });
  }

  // ------------------------------------------------------------------ init

  elFecha.value = hoyISO();
  pintarSemana();

  elTrabajador.addEventListener('change', aplicarTarifaDelTrabajador);
  elFecha.addEventListener('change', () => {
    pintarSemana();
    cargarDia();
  });
  [elInicio, elFin, elTarifa].forEach((campo) => campo.addEventListener('input', recalcular));

  document.querySelectorAll('[data-preset]').forEach((boton) => {
    boton.addEventListener('click', () => {
      const [inicio, fin] = boton.dataset.preset.split('|');
      elInicio.value = inicio;
      elFin.value = fin;
      recalcular();
    });
  });

  botonGuardar.addEventListener('click', guardar);

  (async () => {
    try {
      await cargarTrabajadores();
      recalcular();
      await cargarDia();
    } catch (error) {
      avisoError(error);
      cuerpoDia.innerHTML = `<tr><td colspan="5" class="sin-datos">${esc(error.message)}</td></tr>`;
    }
  })();
</script>
