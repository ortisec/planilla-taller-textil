---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout titulo="Registro diario" subtitulo="Anota lo que hizo cada trabajador. El sistema ya descuenta lo que está hecho.">
  <div slot="acciones">
    <a class="boton secundario" href="/registros">
      <Icon name="lista" size={16} /> Ver todos los registros
    </a>
  </div>

  <div class="tarjeta">
    <div class="tarjeta-cabecera">
      <div>
        <h2>Registrar trabajo</h2>
        <p>Elige la partida, el paquete y quién trabajó. Después revisa las cantidades y guarda.</p>
      </div>
    </div>
    <div class="tarjeta-cuerpo">
      <div class="formulario-rejilla">
        <div class="campo">
          <label for="fecha">¿De qué día es el trabajo?</label>
          <input type="date" id="fecha" />
        </div>
        <div class="campo">
          <label for="partida">Partida</label>
          <select id="partida"><option value="">Cargando…</option></select>
        </div>
        <div class="campo">
          <label for="paquete">Paquete</label>
          <select id="paquete" disabled><option value="">Elige una partida</option></select>
        </div>
        <div class="campo">
          <label for="trabajador">¿Quién trabajó?</label>
          <select id="trabajador"><option value="">Cargando…</option></select>
        </div>
      </div>

      <p class="pista mt-3" id="resumen-partida"></p>

      <div class="bloque mt-4">
        <div class="bloque-cabecera">
          <span class="fila">
            ¿Cuántas prendas hizo?
            <span class="chip primario hidden" id="chip-paquete"></span>
          </span>
          <button type="button" class="boton sutil pequeno" id="vaciar">Borrar cantidades</button>
        </div>
        <div class="bloque-cuerpo" id="lista-operaciones">
          <div class="sin-datos">Elige una partida y un paquete para ver las operaciones.</div>
        </div>
      </div>

      <div class="resumen-pago">
        <div>
          <div class="resumen-etiqueta" id="resumen-titulo">Se le pagará</div>
          <div class="resumen-monto" id="total-registro">S/ 0.00</div>
          <div class="pista" id="pista-guardar">Elige al trabajador y las cantidades.</div>
        </div>
        <button type="button" class="boton grande" id="guardar">
          <Icon name="check" size={17} /> Guardar
        </button>
      </div>

      <details class="mt-3">
        <summary class="pista" style="cursor:pointer">Agregar una nota (opcional)</summary>
        <input type="text" id="notas" class="mt-2" placeholder="Ej. faltó hilo, se repuso una prenda…" />
      </details>
    </div>
  </div>

  <div class="tarjeta">
    <div class="tarjeta-cabecera">
      <div>
        <h2>Lo que se registró <span class="texto-suave" id="titulo-dia"></span></h2>
        <p>Si te equivocaste, borra la línea y vuelve a registrarla.</p>
      </div>
    </div>
    <div class="tarjeta-cuerpo sin-padding">
      <div class="tabla-envoltura">
        <table class="tabla">
          <thead>
            <tr>
              <th>Trabajador y trabajo</th>
              <th class="num" style="width:140px">Se le paga</th>
              <th style="width:64px"></th>
            </tr>
          </thead>
          <tbody id="cuerpo-dia">
            <tr><td colspan="3" class="sin-datos">Cargando…</td></tr>
          </tbody>
          <tfoot id="pie-dia" class="hidden">
            <tr>
              <td>Total del día</td>
              <td class="num" id="total-dia">S/ 0.00</td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { listarTrabajadores, listarPartidas, listarPaquetes, listarAvancePaquete, registrarTrabajo, listarRegistros, eliminarRegistro, esErrorDeExceso } from '../lib/api.js';
  import { soles, precioUnitario, numero, hoyISO, fecha } from '../lib/format.js';
  import { qs, esc, toast, avisoError, confirmar, cargando, mensajeDeError } from '../lib/ui.js';

  const elFecha = qs('#fecha');
  const elTrabajador = qs('#trabajador');
  const elPartida = qs('#partida');
  const elPaquete = qs('#paquete');
  const elNotas = qs('#notas');
  const listaOperaciones = qs('#lista-operaciones');
  const chipPaquete = qs('#chip-paquete');
  const resumenPartida = qs('#resumen-partida');
  const resumenTitulo = qs('#resumen-titulo');
  const totalRegistro = qs('#total-registro');
  const pistaGuardar = qs('#pista-guardar');
  const cuerpoDia = qs('#cuerpo-dia');
  const pieDia = qs('#pie-dia');
  const totalDia = qs('#total-dia');
  const tituloDia = qs('#titulo-dia');
  const botonGuardar = qs('#guardar');

  const estado = {
    trabajadores: [],
    partidas: [],
    avance: [],
    registrosPaquete: [],
    paqueteActual: null,
  };

  const vacio = (mensaje) =>
    `<div class="sin-datos">${esc(mensaje)}</div>`;

  function opciones(select, lista, { placeholder = 'Selecciona…', valor = (x) => x.id, texto = (x) => x.nombre } = {}) {
    select.innerHTML =
      `<option value="">${esc(placeholder)}</option>` +
      lista.map((x) => `<option value="${esc(valor(x))}">${esc(texto(x))}</option>`).join('');
  }

  // -------------------------------------------------------------- catálogos

  async function cargarCatalogos() {
    const [trabajadores, partidas] = await Promise.all([
      listarTrabajadores({ soloActivos: true }),
      listarPartidas(),
    ]);

    estado.trabajadores = trabajadores;
    estado.partidas = partidas.filter((p) => p.estado !== 'anulada');

    opciones(elTrabajador, estado.trabajadores, { placeholder: 'Elige al trabajador' });
    opciones(elPartida, estado.partidas, {
      placeholder: 'Elige la partida',
      texto: (p) => `Partida ${p.codigo}${p.descripcion ? ' — ' + p.descripcion : ''}`,
    });

    const params = new URLSearchParams(location.search);
    const partidaParam = params.get('partida');
    const trabajadorParam = params.get('trabajador');

    if (partidaParam && estado.partidas.some((p) => p.id === partidaParam)) {
      elPartida.value = partidaParam;
    } else if (estado.partidas.length === 1) {
      // Si solo hay una partida, se elige sola para ahorrar pasos.
      elPartida.value = estado.partidas[0].id;
    }

    if (trabajadorParam && estado.trabajadores.some((t) => t.id === trabajadorParam)) {
      elTrabajador.value = trabajadorParam;
    }

    if (elPartida.value) await alCambiarPartida(params.get('paquete'));
  }

  // ----------------------------------------------------------- selecciones

  async function alCambiarPartida(paqueteId = null) {
    const partidaId = elPartida.value;
    estado.avance = [];
    estado.registrosPaquete = [];
    estado.paqueteActual = null;
    elPaquete.disabled = true;
    chipPaquete.classList.add('hidden');
    resumenPartida.textContent = '';
    listaOperaciones.innerHTML = vacio('Cargando…');

    if (!partidaId) {
      elPaquete.innerHTML = '<option value="">Elige una partida</option>';
      listaOperaciones.innerHTML = vacio('Elige una partida y un paquete para ver las operaciones.');
      recalcular();
      return;
    }

    const paquetes = await listarPaquetes(partidaId);
    const partida = estado.partidas.find((p) => p.id === partidaId);

    resumenPartida.textContent = `Partida ${partida?.codigo ?? ''} · ${numero(partida?.num_paquetes ?? 0)} paquetes · ${numero(
      partida?.total_prendas ?? 0
    )} prendas · precio de la prenda ${soles(partida?.precio_prenda ?? 0)}`;

    opciones(elPaquete, paquetes, {
      placeholder: 'Elige el paquete',
      texto: (q) => `Paquete ${q.numero} — Talla ${q.talla} (${q.cantidad} prendas)`,
    });

    if (paquetes.length === 0) {
      elPaquete.innerHTML = '<option value="">Sin paquetes</option>';
      listaOperaciones.innerHTML = vacio('Esta partida todavía no tiene paquetes.');
      recalcular();
      return;
    }

    elPaquete.disabled = false;
    elPaquete.value = paqueteId && paquetes.some((q) => q.id === paqueteId) ? paqueteId : paquetes[0].id;
    await cargarAvance();
  }

  /** Carga lo pendiente del paquete y el trabajo que ya hicieron otros. */
  async function cargarAvance() {
    const paqueteId = elPaquete.value;
    estado.paqueteActual = null;
    if (!paqueteId) return;

    listaOperaciones.innerHTML = vacio('Cargando…');

    const [avance, registros] = await Promise.all([
      listarAvancePaquete(paqueteId),
      listarRegistros({ paqueteId, limite: 500 }),
    ]);

    estado.avance = avance;
    estado.registrosPaquete = registros;

    if (avance.length > 0) {
      estado.paqueteActual = {
        id: paqueteId,
        numero: avance[0].paquete_numero,
        talla: avance[0].paquete_talla,
        cantidad: avance[0].cantidad_paquete,
      };
      chipPaquete.textContent = `Paquete ${avance[0].paquete_numero} · Talla ${avance[0].paquete_talla} · ${avance[0].cantidad_paquete} prendas`;
      chipPaquete.classList.remove('hidden');
    } else {
      chipPaquete.classList.add('hidden');
    }

    renderOperaciones();
    llenarTodo();
  }

  function textoHechoPor(operacionId) {
    const filas = estado.registrosPaquete.filter((r) => r.operacion_id === operacionId);
    if (filas.length === 0) return '';

    const porTrabajador = new Map();
    filas.forEach((r) => {
      porTrabajador.set(r.trabajador, (porTrabajador.get(r.trabajador) ?? 0) + Number(r.cantidad));
    });

    return 'Ya lo hizo: ' + [...porTrabajador].map(([nombre, cant]) => `${nombre} ${numero(cant)}`).join(' · ');
  }

  function filaOperacion(fila) {
    const completa = Number(fila.pendientes) === 0;
    const hechoPor = textoHechoPor(fila.partida_operacion_id);

    const detalle = completa
      ? ['Ya está completo', hechoPor].filter(Boolean).join(' · ')
      : [`Faltan ${numero(fila.pendientes)} de ${numero(fila.cantidad_paquete)}`, hechoPor].filter(Boolean).join(' · ');

    return `
      <div class="fila-operacion"
           data-operacion="${esc(fila.partida_operacion_id)}"
           data-nombre="${esc(fila.operacion)}"
           data-precio="${Number(fila.precio)}"
           data-pendientes="${Number(fila.pendientes)}">
        <div class="op-info">
          <div class="op-nombre">
            ${esc(fila.operacion)}
            ${completa ? '<span class="chip exito">Completo</span>' : ''}
          </div>
          <div class="texto-suave texto-pequeno">${esc(detalle)} · ${esc(precioUnitario(fila.precio))} por prenda</div>
        </div>
        <input type="number" class="cantidad" min="0" step="1" value="0" data-cantidad />
        <div class="op-importe">${esc(soles(0))}</div>
      </div>`;
  }

  function renderOperaciones() {
    if (estado.avance.length === 0) {
      listaOperaciones.innerHTML = vacio('Esta partida no tiene operaciones.');
      return;
    }

    listaOperaciones.innerHTML = estado.avance.map(filaOperacion).join('');
    listaOperaciones.querySelectorAll('[data-cantidad]').forEach((input) => {
      input.addEventListener('input', recalcular);
    });
    recalcular();
  }

  function recalcular() {
    let total = 0;
    let piezas = 0;

    listaOperaciones.querySelectorAll('.fila-operacion').forEach((fila) => {
      const precio = Number(fila.dataset.precio);
      const cantidad = Number(fila.querySelector('[data-cantidad]').value) || 0;
      const subtotal = precio * cantidad;
      fila.querySelector('.op-importe').textContent = soles(subtotal);
      total += subtotal;
      piezas += cantidad;
    });

    totalRegistro.textContent = soles(total);

    const trabajador = estado.trabajadores.find((t) => t.id === elTrabajador.value);
    resumenTitulo.textContent = trabajador ? `Se le pagará a ${trabajador.nombre}` : 'Se le pagará';
    pistaGuardar.textContent =
      piezas > 0
        ? `${numero(piezas)} prenda(s) en total`
        : 'Elige al trabajador y las cantidades que hizo.';
  }

  /** Rellena cada operación con las prendas que faltan por hacer. */
  function llenarTodo() {
    listaOperaciones.querySelectorAll('.fila-operacion').forEach((fila) => {
      fila.querySelector('[data-cantidad]').value = Number(fila.dataset.pendientes) || 0;
    });
    recalcular();
  }

  function vaciar() {
    listaOperaciones.querySelectorAll('[data-cantidad]').forEach((input) => {
      input.value = 0;
    });
    recalcular();
  }

  // ---------------------------------------------------------------- guardar

  function recolectarLineas() {
    const lineas = [];
    listaOperaciones.querySelectorAll('.fila-operacion').forEach((fila) => {
      const cantidad = Number(fila.querySelector('[data-cantidad]').value) || 0;
      if (cantidad > 0) {
        lineas.push({
          partida_operacion_id: fila.dataset.operacion,
          nombre: fila.dataset.nombre,
          cantidad,
          pendientes: Number(fila.dataset.pendientes) || 0,
        });
      }
    });
    return lineas;
  }

  async function guardar() {
    const fechaTrabajo = elFecha.value;
    if (!fechaTrabajo) return toast('Elige la fecha del trabajo.', 'aviso');
    if (!elTrabajador.value) return toast('Elige quién trabajó.', 'aviso');
    if (!elPartida.value) return toast('Elige la partida.', 'aviso');
    if (!elPaquete.value) return toast('Elige el paquete.', 'aviso');

    const lineas = recolectarLineas();
    if (lineas.length === 0) return toast('Escribe cuántas prendas hizo.', 'aviso');

    const trabajador = estado.trabajadores.find((t) => t.id === elTrabajador.value);
    const datos = {
      fecha: fechaTrabajo,
      trabajadorId: elTrabajador.value,
      partidaId: elPartida.value,
      paqueteId: elPaquete.value,
      lineas,
      notas: elNotas.value || null,
    };

    try {
      const repetidos = await listarRegistros({
        desde: fechaTrabajo,
        hasta: fechaTrabajo,
        trabajadorId: datos.trabajadorId,
        paqueteId: datos.paqueteId,
        limite: 50,
      });

      if (repetidos.length > 0) {
        const continuar = await confirmar({
          titulo: 'Ya está registrado',
          mensaje: `${trabajador?.nombre ?? 'Este trabajador'} ya tiene trabajo anotado en este paquete para el ${fecha(
            fechaTrabajo
          )}.\n\n¿Quieres anotarlo otra vez?`,
          textoAceptar: 'Sí, anotar igual',
        });
        if (!continuar) return;
      }

      // Aviso por exceso: se anotan más prendas de las que faltan.
      const excesos = lineas.filter((l) => l.cantidad > l.pendientes);
      let permitirExceso = false;

      if (excesos.length > 0) {
        const detalle = excesos
          .map((l) => `• ${l.nombre}: anotas ${numero(l.cantidad)} y solo faltan ${numero(l.pendientes)}`)
          .join('\n');

        const continuar = await confirmar({
          titulo: 'Más prendas de las que faltan',
          mensaje: `${detalle}\n\nEsas prendas ya fueron anotadas por alguien más. Si continúas se pagarían dos veces.\n\n¿Anotar igual?`,
          textoAceptar: 'Sí, anotar igual',
          peligro: true,
        });
        if (!continuar) return;
        permitirExceso = true;
      }

      cargando(botonGuardar, true, 'Guardando…');

      try {
        await registrarTrabajo(datos, { permitirExceso });
      } catch (error) {
        if (!esErrorDeExceso(error)) throw error;

        const continuar = await confirmar({
          titulo: 'Más prendas de las que faltan',
          mensaje: `${mensajeDeError(error)}\n\n¿Anotar igual?`,
          textoAceptar: 'Sí, anotar igual',
          peligro: true,
        });
        if (!continuar) return;
        await registrarTrabajo(datos, { permitirExceso: true });
      }

      toast('Listo, se guardó el trabajo.', 'exito');
      elNotas.value = '';
      await cargarAvance();
      await cargarDia();
    } catch (error) {
      avisoError(error);
    } finally {
      cargando(botonGuardar, false);
    }
  }

  // ------------------------------------------------------------ día actual

  async function cargarDia() {
    const dia = elFecha.value || hoyISO();
    tituloDia.textContent = `· ${fecha(dia)}`;
    cuerpoDia.innerHTML = '<tr><td colspan="3" class="sin-datos">Cargando…</td></tr>';

    const registros = await listarRegistros({ desde: dia, hasta: dia, limite: 500 });

    if (registros.length === 0) {
      cuerpoDia.innerHTML = '<tr><td colspan="3" class="sin-datos">Todavía no anotaste trabajo de este día.</td></tr>';
      pieDia.classList.add('hidden');
      return;
    }

    cuerpoDia.innerHTML = registros
      .map(
        (r) => `
        <tr>
          <td>
            <div class="negrita">
              ${esc(r.trabajador)}
              ${r.pago_id ? '<span class="chip exito">Ya pagado</span>' : ''}
            </div>
            <div class="texto-suave texto-pequeno">
              ${esc(r.operacion)} · Partida ${esc(r.partida_codigo)} · Paquete ${esc(r.paquete_numero)} (${esc(r.paquete_talla)}) · ${esc(numero(r.cantidad))} u.
            </div>
          </td>
          <td class="num negrita">${esc(soles(r.subtotal))}</td>
          <td class="acciones-fila">
            <button type="button" class="boton icono peligro" data-borrar="${esc(r.id)}" title="Borrar">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </td>
        </tr>`
      )
      .join('');

    totalDia.textContent = soles(registros.reduce((suma, r) => suma + Number(r.subtotal), 0));
    pieDia.classList.remove('hidden');

    cuerpoDia.querySelectorAll('[data-borrar]').forEach((boton) => {
      boton.addEventListener('click', async () => {
        const ok = await confirmar({
          titulo: 'Borrar esta línea',
          mensaje: '¿Seguro que quieres borrarla? Después puedes volver a anotarla.',
          textoAceptar: 'Borrar',
          peligro: true,
        });
        if (!ok) return;
        try {
          await eliminarRegistro(boton.dataset.borrar);
          toast('Línea borrada.', 'exito');
          await cargarAvance();
          await cargarDia();
        } catch (error) {
          avisoError(error);
        }
      });
    });
  }

  // ------------------------------------------------------------------ init

  elFecha.value = hoyISO();
  elFecha.addEventListener('change', cargarDia);
  elPartida.addEventListener('change', () => alCambiarPartida());
  elPaquete.addEventListener('change', cargarAvance);
  elTrabajador.addEventListener('change', recalcular);
  qs('#vaciar').addEventListener('click', vaciar);
  botonGuardar.addEventListener('click', guardar);

  (async () => {
    try {
      await cargarCatalogos();
      recalcular();
      await cargarDia();
    } catch (error) {
      avisoError(error);
      listaOperaciones.innerHTML = vacio(error.message);
    }
  })();
</script>
